# OpenHands Frontend Environment Variables

# Backend API configuration
VITE_BACKEND_HOST=127.0.0.1:3000
VITE_USE_TLS=false
VITE_INSECURE_SKIP_VERIFY=false

# Frontend configuration
VITE_FRONTEND_PORT=3001

# Base path for frontend routes (URI prefix)
# Set this to add a path prefix to all frontend routes
# Example: VITE_BASE_PATH=/openhands will make the app accessible at http://localhost:3001/openhands
VITE_BASE_PATH=/openhands

# To disable base path and use root path, comment out or set to empty:
# VITE_BASE_PATH=